/* ****************************************************** */
<LAND_GENERATION>
base_terrain LEAVES
create_player_lands
{
terrain_type LEAVES
land_percent 95
zone 1
base_size 8
}

/* ****************************************************** */
<TERRAIN_GENERATION>
create_terrain MED_WATER
{
base_terrain LEAVES
number_of_clumps 1
land_percent 1
height_limits 0 0
set_flat_terrain_only
set_avoid_player_start_areas
set_scale_by_groups
spacing_to_other_terrain_types 1
}

create_terrain PINE_FOREST
{
base_terrain LEAVES
number_of_clumps 50
land_percent 2
set_avoid_player_start_areas
set_scale_by_groups
}

