<PLAYER_SETUP>
  random_placement

<LAND_GENERATION>

  base_terrain DIRT3

create_player_lands
{
  terrain_type GRASS
  base_size 20
  land_percent 100
  set_zone_by_team
  other_zone_avoidance_distance 10
}

<TERRAIN_GENERATION>

create_terrain SHALLOW
{
  base_terrain DIRT3
land_percent 100
number_of_clumps 100
spacing_to_other_terrain_types 2
}

create_terrain BEACH
{
  base_terrain DIRT3
land_percent 10
number_of_clumps 5
spacing_to_other_terrain_types 0
}

create_terrain SHALLOW
{
  base_terrain BEACH
if TINY_MAP
number_of_tiles 120
elseif MEDIUM_MAP
number_of_tiles 160
else
number_of_tiles 200
endif
number_of_clumps 20
}

create_terrain WATER
{
  base_terrain SHALLOW
if TINY_MAP
number_of_tiles 120
elseif MEDIUM_MAP
number_of_tiles 140
else
number_of_tiles 160
endif
number_of_clumps 12
}

